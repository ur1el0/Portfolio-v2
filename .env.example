# Resend API Key for visitor telemetry alerts
RESEND_API_KEY=re_your_api_key_here

# Visitor alert email delivery is disabled unless explicitly enabled
PORTFOLIO_ALERTS_ENABLED=false

# Shared request limiter (required before enabling visitor alerts)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Recipient email address for visitor alerts
ALERT_RECIPIENT_EMAIL=your_email@example.com
