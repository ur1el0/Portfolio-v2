---
import CopyEmail from './CopyEmail.astro';
---

<header class="lg:sticky lg:top-0 lg:flex lg:max-h-screen lg:w-1/2 lg:flex-col lg:justify-between lg:py-24">
  <div>
    <h1 class="text-4xl font-bold tracking-tight text-slate-100 sm:text-5xl">
      <a href="/">Roosc Zaño</a>
    </h1>
    <h2 class="mt-3 text-lg font-medium tracking-tight text-accent-cyan sm:text-xl font-mono">
      Full-Stack Developer
    </h2>
    <p class="mt-4 max-w-xs leading-normal text-slate-400 text-sm">
      Building scalable web applications, real-time engines, and robust API architectures with React, Django REST, and PostgreSQL.
    </p>

    <nav class="nav hidden lg:block" aria-label="In-page jump links">
      <ul class="mt-16 w-max">
        <li>
          <a class="group flex items-center py-3 active" href="#about">
            <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-accent-cyan group-focus-visible:w-16 group-focus-visible:bg-accent-cyan font-mono"></span>
            <span class="nav-text text-xs font-mono tracking-widest text-slate-500 uppercase group-hover:text-slate-200 group-focus-visible:text-slate-200">01. About</span>
          </a>
        </li>
        <li>
          <a class="group flex items-center py-3" href="#projects">
            <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-accent-cyan group-focus-visible:w-16 group-focus-visible:bg-accent-cyan font-mono"></span>
            <span class="nav-text text-xs font-mono tracking-widest text-slate-500 uppercase group-hover:text-slate-200 group-focus-visible:text-slate-200">02. Projects</span>
          </a>
        </li>
        <li>
          <a class="group flex items-center py-3" href="#skills">
            <span class="nav-indicator mr-4 h-px w-8 bg-slate-600 transition-all group-hover:w-16 group-hover:bg-accent-cyan group-focus-visible:w-16 group-focus-visible:bg-accent-cyan font-mono"></span>
            <span class="nav-text text-xs font-mono tracking-widest text-slate-500 uppercase group-hover:text-slate-200 group-focus-visible:text-slate-200">03. Skills & Credentials</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="mt-8 flex flex-col gap-4">
    <CopyEmail email="zanoroosc@gmail.com" />
    
    <ul class="ml-1 flex items-center gap-5 text-slate-400" aria-label="Social media links">
      <li>
        <a href="https://github.com/ur1el0" target="_blank" rel="noreferrer" class="hover:text-accent-cyan transition-colors" aria-label="GitHub">
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
      </li>
      <li>
        <a href="https://www.linkedin.com/in/roosc-za%C3%B1o-08568a357/?skipRedirect=true" target="_blank" rel="noreferrer" class="hover:text-accent-cyan transition-colors" aria-label="LinkedIn">
          <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        </a>
      </li>
    </ul>
  </div>
</header>