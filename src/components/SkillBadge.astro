---
interface Props {
  name: string;
  category?: 'frontend' | 'backend' | 'cloud' | 'credential';
  verified?: boolean;
}

const { name, category = 'frontend', verified = false } = Astro.props;

const categoryStyles = {
  frontend: 'bg-sky-500/10 text-sky-400 border-sky-500/20',
  backend: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20',
  cloud: 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20',
  credential: 'bg-amber-500/10 text-amber-300 border-amber-500/30',
};
---

<span class={`inline-flex items-center gap-1.5 rounded-md border px-2.5 py-1 text-xs font-mono font-medium transition-transform hover:scale-105 ${categoryStyles[category]}`}>
  {verified && (
    <svg class="h-3 w-3 text-amber-400" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
    </svg>
  )}
  <span>{name}</span>
</span>