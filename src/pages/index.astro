---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillBadge from '../components/SkillBadge.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);

const awardsAndCompetitions = [
  {
    title: 'Top Performer — Open iT Applied Full-Stack & Data Science Bootcamp',
    issuer: 'Open iT',
    date: '2026',
    description: 'Recognized as Top Performer in an intensive multi-month bootcamp covering ASP.NET Core, React, relational database schemas, and Docker containerization.',
    fileHref: '/assets/participation/topPerformer.jpg',
  },
  {
    title: 'Participant & Team Leader — DLSU HackerCup',
    issuer: 'De La Salle University',
    date: '2025',
    description: 'Led a 4-person collegiate engineering team designing real-time civic disaster response and community coordination platforms under 24-hour hackathon constraints.',
    fileHref: '/assets/participation/hackercup.pdf',
  },
  {
    title: 'Participant — Inventi Hackathon Challenge',
    issuer: 'Inventi',
    date: '2025',
    description: 'Competed in rapid software prototyping, architecting API endpoints and data models under accelerated delivery time constraints.',
    fileHref: '/assets/participation/inventi.jpg',
  },
];

const industryCertifications = [
  {
    title: 'Microsoft Certified: Azure Fundamentals (AZ-900)',
    issuer: 'Microsoft',
    date: '2026',
    description: 'Validates foundational cloud architecture concepts, Azure core services, security governance, resource compliance, and identity protection.',
    fileHref: '/assets/certifications/az900-cert.pdf',
  },
];

const professionalTraining = [
  {
    title: 'Database Design and Basic SQL in PostgreSQL',
    issuer: 'University of Michigan (Coursera)',
    date: '2025',
    description: 'Relational database schema modeling, primary/foreign key normalization, SQL query optimization, and transaction boundaries.',
    fileHref: '/assets/certifications/Coursera-postgres-cert.pdf',
  },
  {
    title: 'Operating System Virtualization',
    issuer: 'Illinois Institute of Technology (Coursera)',
    date: '2025',
    description: 'Hardware virtualization primitives, container kernel namespaces, cgroups, process scheduling, and resource isolation boundaries.',
    fileHref: '/assets/certifications/Coursera-os-cert.pdf',
  },
  {
    title: 'Flutter and Dart: Developing iOS, Android, and Mobile Apps',
    issuer: 'Coursera',
    date: '2025',
    description: 'State management paradigms, widget lifecycle architecture, asynchronous Dart pipelines, and cross-platform native mobile compilation.',
    fileHref: '/assets/certifications/Coursera-flutter&dart-cert.pdf',
  },
];
---

<BaseLayout>
  <div class="lg:flex lg:justify-between lg:gap-4">
    <Header />

    <main id="content" class="pt-24 lg:w-[54%] lg:py-24">
      <!-- Section 01: About -->
      <section id="about" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="About me">
        <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-bg-dark/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-0 lg:w-auto lg:opacity-0">
          <h2 class="text-sm font-mono font-bold uppercase tracking-widest text-slate-200">01. About</h2>
        </div>
        <div class="space-y-4 text-lg leading-relaxed text-slate-400">
          <p>
            I am a backend-focused BSIT student at Manuel S. Enverga University Foundation (<span class="font-medium text-slate-200">GWA: 1.5937, Dean's Lister</span>).
          </p>
          <p>
            I focus on building secure REST APIs and containerized backend services using <span class="font-medium text-slate-200">Django REST Framework</span>, <span class="font-medium text-slate-200">ASP.NET Core</span>, and <span class="font-medium text-slate-200">PostgreSQL</span>.
          </p>
        </div>
      </section>

      <!-- Section 02: Projects -->
      <section id="projects" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="Selected projects">
        <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-bg-dark/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-0 lg:w-auto lg:opacity-0">
          <h2 class="text-sm font-mono font-bold uppercase tracking-widest text-slate-200">02. Projects</h2>
        </div>
        <div>
          <ul class="group/projects space-y-12">
            {sortedProjects.map((project) => (
              <li>
                <ProjectCard
                  title={project.data.title}
                  summary={project.data.summary}
                  period={project.data.period}
                  role={project.data.role}
                  techStack={project.data.techStack}
                  githubUrl={project.data.githubUrl}
                  liveUrl={project.data.liveUrl}
                  slug={project.id}
                  image={project.data.image}
                  kicker={project.data.kicker}
                  metrics={project.data.metrics}
                />
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- Section 03: Skills, Education & Credentials -->
      <section id="skills" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-32 lg:scroll-mt-24" aria-label="Skills and credentials">
        <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-bg-dark/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-0 lg:w-auto lg:opacity-0">
          <h2 class="text-sm font-mono font-bold uppercase tracking-widest text-slate-200">03. Education & Credentials</h2>
        </div>

        <div class="space-y-10">
          <!-- Education & Training -->
          <div>
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 mb-3">Education & Academic Background</h3>
            <div class="space-y-3">
              <div class="rounded-lg border border-border-subtle/10 bg-bg-surface/30 p-4">
                <div class="flex items-center justify-between">
                  <span class="font-medium text-slate-200 text-base">Manuel S. Enverga University Foundation</span>
                  <span class="text-xs font-mono text-slate-500">2023 – Present</span>
                </div>
                <div class="mt-1 text-sm text-slate-400">Bachelor of Science in Information Technology, Web and Mobile Application Development</div>
                <div class="mt-1 text-xs font-mono text-accent-cyan">GWA: 1.5937 · Dean's Lister</div>
              </div>
              <div class="rounded-lg border border-border-subtle/10 bg-bg-surface/30 p-4">
                <div class="flex items-center justify-between">
                  <span class="font-medium text-slate-200 text-base">Open iT Applied Full Stack and Data Science Bootcamp</span>
                  <span class="text-xs font-mono text-slate-500">2026</span>
                </div>
                <div class="mt-1 text-sm text-slate-400">Full Stack Development Track (ASP.NET Core, React, SQL databases, REST APIs, Docker)</div>
              </div>
            </div>
          </div>

          <!-- Technical Stack -->
          <div>
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 mb-3">Core Technical Skills</h3>
            <div class="flex flex-wrap gap-2">
              <SkillBadge name="Python" category="backend" />
              <SkillBadge name="C#" category="backend" />
              <SkillBadge name="JavaScript / TypeScript" category="frontend" />
              <SkillBadge name="Kotlin" category="frontend" />
              <SkillBadge name="Django REST Framework" category="backend" />
              <SkillBadge name="ASP.NET Core" category="backend" />
              <SkillBadge name="React" category="frontend" />
              <SkillBadge name="Flutter" category="frontend" />
              <SkillBadge name="PostgreSQL" category="backend" />
              <SkillBadge name="Docker" category="cloud" />
              <SkillBadge name="Microsoft Azure" category="cloud" />
            </div>
          </div>

          <!-- Awards & Competitions -->
          <div>
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-accent-cyan mb-3">Awards & Competitions</h3>
            <ul class="space-y-3">
              {awardsAndCompetitions.map((item) => (
                <li class="rounded-lg border border-border-subtle/10 bg-bg-surface/30 p-4 hover:border-accent-cyan/40 transition-colors">
                  <div class="flex items-baseline justify-between gap-2">
                    <span class="font-medium text-slate-200 text-sm">{item.title}</span>
                    <span class="text-xs font-mono text-slate-500 shrink-0">{item.date}</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-400 leading-relaxed">
                    {item.description}
                  </p>
                  <div class="mt-3 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-500">{item.issuer}</span>
                    <button
                      class="cert-modal-btn text-accent-cyan underline hover:text-accent-cyan/80 cursor-pointer font-medium"
                      data-title={item.title}
                      data-issuer={item.issuer}
                      data-file={item.fileHref}
                    >
                      View Certificate
                    </button>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Industry Certifications -->
          <div>
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-accent-cyan mb-3">Industry Certifications</h3>
            <ul class="space-y-3">
              {industryCertifications.map((cert) => (
                <li class="rounded-lg border border-border-subtle/10 bg-bg-surface/30 p-4 hover:border-accent-cyan/40 transition-colors">
                  <div class="flex items-baseline justify-between gap-2">
                    <span class="font-medium text-slate-200 text-sm">{cert.title}</span>
                    <span class="text-xs font-mono text-slate-500 shrink-0">{cert.date}</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-400 leading-relaxed">
                    {cert.description}
                  </p>
                  <div class="mt-3 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-500">{cert.issuer}</span>
                    <button
                      class="cert-modal-btn text-accent-cyan underline hover:text-accent-cyan/80 cursor-pointer font-medium"
                      data-title={cert.title}
                      data-issuer={cert.issuer}
                      data-file={cert.fileHref}
                    >
                      View Certificate
                    </button>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Academic & Professional Training -->
          <div>
            <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-accent-cyan mb-3">Verified Coursework & Specializations</h3>
            <ul class="space-y-3">
              {professionalTraining.map((item) => (
                <li class="rounded-lg border border-border-subtle/10 bg-bg-surface/30 p-4 hover:border-accent-cyan/40 transition-colors">
                  <div class="flex items-baseline justify-between gap-2">
                    <span class="font-medium text-slate-200 text-sm">{item.title}</span>
                    <span class="text-xs font-mono text-slate-500 shrink-0">{item.date}</span>
                  </div>
                  <p class="mt-1.5 text-xs text-slate-400 leading-relaxed">
                    {item.description}
                  </p>
                  <div class="mt-3 flex items-center justify-between text-xs font-mono">
                    <span class="text-slate-500">{item.issuer}</span>
                    <button
                      class="cert-modal-btn text-accent-cyan underline hover:text-accent-cyan/80 cursor-pointer font-medium"
                      data-title={item.title}
                      data-issuer={item.issuer}
                      data-file={item.fileHref}
                    >
                      View Certificate
                    </button>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <Footer />
    </main>
  </div>

  <dialog id="cert-modal" class="fixed inset-0 z-50 rounded-xl bg-bg-dark/95 border border-border-subtle/20 p-6 text-slate-200 backdrop-blur-md max-w-2xl w-full mx-auto my-auto backdrop:bg-black/80">
    <div class="flex items-center justify-between pb-4 border-b border-border-subtle/10">
      <div>
        <h3 id="modal-title" class="text-lg font-bold text-slate-100"></h3>
        <p id="modal-issuer" class="text-xs font-mono text-accent-cyan mt-1"></p>
      </div>
      <button id="close-modal" class="text-slate-400 hover:text-slate-100 font-mono text-sm px-2 py-1 cursor-pointer">✕ Close</button>
    </div>
    <div class="mt-4 flex flex-col items-center">
      <iframe id="modal-frame" class="w-full h-[60vh] rounded border border-border-subtle/10 bg-white/5" src=""></iframe>
    </div>
  </dialog>

  <script>
    const modal = document.getElementById('cert-modal') as HTMLDialogElement;
    const modalTitle = document.getElementById('modal-title');
    const modalIssuer = document.getElementById('modal-issuer');
    const modalFrame = document.getElementById('modal-frame') as HTMLIFrameElement;
    const closeModal = document.getElementById('close-modal');

    document.querySelectorAll('.cert-modal-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const title = btn.getAttribute('data-title') || '';
        const issuer = btn.getAttribute('data-issuer') || '';
        const file = btn.getAttribute('data-file') || '';

        if (modalTitle) modalTitle.textContent = title;
        if (modalIssuer) modalIssuer.textContent = `Issuer: ${issuer}`;
        if (modalFrame) modalFrame.src = file;
        if (modal) modal.showModal();
      });
    });

    if (closeModal && modal) {
      closeModal.addEventListener('click', () => {
        modal.close();
        if (modalFrame) modalFrame.src = '';
      });
    }
  </script>
</BaseLayout>