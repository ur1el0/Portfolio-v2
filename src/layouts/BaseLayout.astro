---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Roosc Zaño | Backend Developer & BSIT Student',
  description = 'Roosc Zaño is a BS Information Technology student and backend developer in Lucena, Philippines, building REST APIs and full-stack applications.',
} = Astro.props;

const personDescription = 'Roosc Zaño is a BS Information Technology student at Manuel S. Enverga University Foundation in Lucena, Philippines, building backend services and full-stack applications.';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://roosc-zano.vercel.app/#person',
  name: 'Roosc Zaño',
  url: 'https://roosc-zano.vercel.app/',
  image: 'https://roosc-zano.vercel.app/assets/hero/profile.jpg',
  jobTitle: 'Information Technology Student and Backend Developer',
  affiliation: {
    '@type': 'EducationalOrganization',
    name: 'Manuel S. Enverga University Foundation',
  },
  description: personDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Lucena',
    addressRegion: 'Quezon',
    addressCountry: 'Philippines',
  },
  sameAs: [
    'https://github.com/ur1el0',
    'https://www.linkedin.com/in/roosc-za%C3%B1o-08568a357/',
    'https://linktr.ee/roosczano',
  ],
  knowsAbout: [
    'Django REST Framework',
    'ASP.NET Core',
    'React',
    'PostgreSQL',
    'Flutter',
    'Docker',
    'Microsoft Azure',
  ],
});
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL.href} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Roosc Zaño" />
    <meta name="google-site-verification" content="aZ6z3MLFpL2x44lxbzBEYxHVemP2nkXDMsR-Fh6erZ4" />
    <meta name="keywords" content="Roosc Zaño, Roosc Zano, Backend Developer Lucena, Enverga University BSIT, Django REST, ASP.NET Core, PostgreSQL, Docker, Developer Portfolio" />

    <!-- Person identity data stays consistent across portfolio pages. -->
    <script type="application/ld+json" is:inline set:html={personSchema} />

    <!-- Theme Initialization Script (Prevents Flickering) -->
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'light' || (!storedTheme && window.matchMedia('(prefers-color-scheme: light)').matches)) {
        document.documentElement.classList.add('light');
      } else {
        document.documentElement.classList.remove('light');
      }
    </script>

    <!-- Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Visitor Telemetry & Notification Script -->
    <script src="../scripts/telemetry.ts"></script>

    <ClientRouter />
  </head>
  <body class="bg-bg-dark text-slate-300 min-h-screen font-sans selection:bg-accent-cyan/20 selection:text-accent-cyan relative">
    <div
      id="spotlight"
      class="pointer-events-none fixed inset-0 z-30 transition duration-300"
      style="background: radial-gradient(600px circle at 0px 0px, hsl(var(--accent-cyan) / 0.08), transparent 80%);"
    ></div>

    <div class="mx-auto min-h-screen max-w-7xl px-6 py-12 md:px-12 md:py-20 lg:px-16 lg:py-0">
      <slot />
    </div>

    <script>
      const spotlight = document.getElementById('spotlight');
      if (spotlight) {
        window.addEventListener('mousemove', (e) => {
          spotlight.style.background = `radial-gradient(600px circle at ${e.clientX}px ${e.clientY}px, hsl(var(--accent-cyan) / 0.08), transparent 80%)`;
        });
      }
    </script>
  </body>
</html>
