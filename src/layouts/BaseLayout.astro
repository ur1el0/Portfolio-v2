---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Roosc Zaño — Full-Stack Developer & Systems Architect',
  description = 'Full-Stack Developer specializing in building scalable web applications with React, Django REST Framework, and PostgreSQL.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />
  </head>
  <body class="bg-[#090a0f] text-slate-400 min-h-screen font-sans selection:bg-sky-500/20 selection:text-sky-400 relative">
    <!-- Ambient Radial Spotlight (Brittany Chiang / p5aholic style) -->
    <div
      id="spotlight"
      class="pointer-events-none fixed inset-0 z-30 transition duration-300"
      style="background: radial-gradient(600px circle at 0px 0px, rgba(56, 189, 248, 0.07), transparent 80%);"
    ></div>

    <div class="mx-auto min-h-screen max-w-screen-xl px-6 py-12 md:px-12 md:py-20 lg:px-24 lg:py-0">
      <slot />
    </div>

    <!-- Zero-dependency Spotlight Tracker -->
    <script>
      const spotlight = document.getElementById('spotlight');
      if (spotlight) {
        window.addEventListener('mousemove', (e) => {
          spotlight.style.background = `radial-gradient(600px circle at ${e.clientX}px ${e.clientY}px, rgba(56, 189, 248, 0.07), transparent 80%)`;
        });
      }
    </script>
  </body>
</html>